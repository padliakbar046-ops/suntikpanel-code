<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SuntikPanel - Layanan Sosial Media</title>
<link rel="stylesheet" href="style.css">
</head>
<body>

<div class="top-header">
  <div class="brand">
    <img src="logo.png" class="logo-img" alt="Logo" onerror="this.style.display='none'">
    <div class="brand-text">
      <h1>SuntikPanel</h1>
      <small id="userGreet">Halo</small>
    </div>
  </div>

  <div class="header-actions">
    <button type="button" class="btn-theme" onclick="toggleTheme()" id="themeBtn">
      <span id="themeIcon">☾</span>
    </button>
    <a href="/saldo.html" class="btn-saldo" id="saldoText">Rp 0</a>
    <a href="/menu.html" class="btn-menu">MENU</a>
  </div>
</div>

<div class="hero">
  <div class="hero-badge">PROSES CEPAT &amp; AMAN</div>
  <h2>Suntik Like, View,<br>Follower <span>Murah</span></h2>
  <p>TikTok, Instagram, Facebook. Proses otomatis 24 jam.</p>
  <div class="hero-stats">
    <div class="hero-stat"><b>500+</b><small>ORDER</small></div>
    <div class="hero-stat"><b>24/7</b><small>ONLINE</small></div>
    <div class="hero-stat"><b>3</b><small>PLATFORM</small></div>
  </div>
</div>

<div class="section-title">
  <h3>Pilih Platform</h3>
  <span>Klik untuk order</span>
</div>

<div class="platform-list">
  <div class="platform-card p-tiktok" onclick="pilihPlatform('tiktok')">
    <div class="pc-icon"><svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.69a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.12z" fill="#000"/></svg></div>
    <div class="pc-info"><b>TikTok</b>
      <div><span class="price-tag" id="tag-tiktok-like">Like</span><span class="price-tag" id="tag-tiktok-follower">Follower</span></div>
    </div>
    <div class="pc-arrow">›</div>
  </div>

  <div class="platform-card p-instagram" onclick="pilihPlatform('instagram')">
    <div class="pc-icon"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5.5" fill="url(#ig1)"/><circle cx="12" cy="12" r="4.2" stroke="#fff" stroke-width="1.8" fill="none"/><circle cx="17.6" cy="6.4" r="1.2" fill="#fff"/><defs><linearGradient id="ig1" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#FEDA75"/><stop offset="0.3" stop-color="#FA7E1E"/><stop offset="0.55" stop-color="#D62976"/><stop offset="0.8" stop-color="#962FBF"/><stop offset="1" stop-color="#4F5BD5"/></linearGradient></defs></svg></div>
    <div class="pc-info"><b>Instagram</b>
      <div><span class="price-tag" id="tag-instagram-like">Like</span><span class="price-tag" id="tag-instagram-follower">Follower</span></div>
    </div>
    <div class="pc-arrow">›</div>
  </div>

  <div class="platform-card p-facebook" onclick="pilihPlatform('facebook')">
    <div class="pc-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#1877F2"/><path d="M15.5 12.5h-2.3V20h-3v-7.5H8.6v-2.6h1.6V8.4c0-1.8 1-2.9 2.9-2.9.9 0 1.7.1 1.9.1v2.2h-1.3c-.9 0-1.1.4-1.1 1v1.1h2.4l-.5 2.6z" fill="#fff"/></svg></div>
    <div class="pc-info"><b>Facebook</b>
      <div><span class="price-tag" id="tag-facebook-like">Like</span><span class="price-tag" id="tag-facebook-follower">Follower</span></div>
    </div>
    <div class="pc-arrow">›</div>
  </div>
</div>

<div class="section-title"><h3>Kenapa Pilih Kami</h3></div>

<div class="fitur-grid">
  <div class="fitur-card"><div class="fc-icon"><svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="#2563eb"/></svg></div><b>Cepat</b><small>1-30 menit</small></div>
  <div class="fitur-card"><div class="fc-icon"><svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" fill="#2563eb"/><path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="#2563eb" stroke-width="2" fill="none"/></svg></div><b>Aman</b><small>Tanpa password</small></div>
  <div class="fitur-card"><div class="fc-icon"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" fill="#2563eb"/><line x1="2" y1="10" x2="22" y2="10" stroke="#fff" stroke-width="2"/></svg></div><b>QRIS</b><small>All payment</small></div>
  <div class="fitur-card"><div class="fc-icon"><svg viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="2" fill="#2563eb"/><circle cx="12" cy="18" r="1" fill="#fff"/></svg></div><b>Mobile</b><small>Mudah dipakai</small></div>
</div>

<div class="section-title" id="order">
  <h3>Form Pemesanan</h3>
  <span>Isi data di bawah</span>
</div>

<form id="orderForm" class="form-card">
  <div class="form-row">
    <label>Platform</label>
    <select id="platform" required onchange="updateHarga()">
      <option value="">Pilih platform</option>
      <option value="tiktok">TikTok</option>
      <option value="instagram">Instagram</option>
      <option value="facebook">Facebook</option>
    </select>
  </div>
  <div class="form-row">
    <label>Jenis Layanan</label>
    <select id="layanan" required onchange="updateHarga()">
      <option value="">Pilih layanan</option>
      <option value="like">Like</option>
      <option value="view">View</option>
      <option value="follower">Follower</option>
      <option value="comment">Comment</option>
      <option value="share">Share</option>
    </select>
  </div>
  <div id="hargaCard" class="harga-card hidden">
    <div class="hc-row big"><span>Harga</span><b id="hargaSatuan">-</b></div>
    <div class="hc-row"><span>Minimal order</span><b id="minOrderText">-</b></div>
  </div>
  <div class="form-row">
    <label>Link atau Username Target</label>
    <input type="text" id="link" placeholder="contoh: @username atau https://..." required>
  </div>
  <div class="form-row">
    <label>Jumlah</label>
    <input type="number" id="jumlah" placeholder="Minimal 100 (comment: 50)" min="50" required oninput="hitungTotal()">
  </div>
  <div id="totalCard" class="total-preview hidden">
    <div class="tp-row"><span>Total bayar</span><b id="previewTotal">Rp 0</b></div>
    <div class="tp-row small"><span>Saldo kamu</span><b id="previewSaldo">Rp 0</b></div>
  </div>
  <button type="submit" id="submitBtn" class="btn-primary">Bayar dengan Saldo</button>
</form>

<div id="payBox" class="hidden">
  <div class="pay-header">
    <div class="pay-icon"><svg viewBox="0 0 24 24" style="width:42px;height:42px;margin:0 auto"><path d="M20 6L9 17l-5-5" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
    <h3>Order Berhasil</h3>
    <p>Pesanan kamu sedang diproses</p>
  </div>
  <div class="total-card">
    <small>ID ORDER</small>
    <div class="order-id-row" style="margin-top:8px"><b id="orderIdText">-</b><button class="copy-btn" onclick="copyOrderId()">Salin</button></div>
    <div style="margin-top:16px;display:flex;justify-content:space-between;font-size:12px;padding:0 4px"><span style="color:#7a8a9a">Total terpotong</span><b id="totalText" style="color:#2563eb">Rp 0</b></div>
    <div style="margin-top:8px;display:flex;justify-content:space-between;font-size:12px;padding:0 4px"><span style="color:#7a8a9a">Saldo tersisa</span><b id="saldoSisaText" style="color:#10b981">Rp 0</b></div>
  </div>
  <a id="waBtn" class="btn-wa" target="_blank">Hubungi Admin via WhatsApp</a>
  <div class="waiting-card">
    <div class="waiting-icon"><svg viewBox="0 0 24 24" style="width:28px;height:28px"><circle cx="12" cy="12" r="10" fill="none" stroke="#f59e0b" stroke-width="2"/><path d="M12 6v6l4 2" stroke="#f59e0b" stroke-width="2" fill="none" stroke-linecap="round"/></svg></div>
    <div class="waiting-text"><b>Estimasi Proses</b><small>Pesanan diproses maksimal <b>30 menit</b>. Cek status di halaman Riwayat.</small></div>
  </div>
  <button class="btn-secondary" onclick="location.href='/riwayat.html'">Lihat Riwayat Order</button>
  <button class="btn-secondary" onclick="location.reload()">Buat Order Baru</button>
</div>

<div class="footer">
  <p><b>SuntikPanel</b> &middot; 2025</p>
  <p>WhatsApp: <a href="https://wa.me/6289674642514">0896-7464-2514</a></p>
</div>

<script src="app.js"></script>
<script>
  const userData = localStorage.getItem('user');
  const isGuest = new URLSearchParams(location.search).get('guest');
  if (!userData && !isGuest) location.href = '/login.html';

  // Set icon theme saat halaman dimuat
  setTimeout(function() {
    const icon = document.getElementById('themeIcon');
    const theme = localStorage.getItem('theme') || 'light';
    if (icon) icon.textContent = theme === 'dark' ? '☀' : '☾';
  }, 50);
</script>
</body>
</html>
