app.get('/api/user/:whatsapp/stats', (req, res) => {
  try {
    const key = req.params.whatsapp.replace(/[^0-9]/g, '');
    const orders = Object.values(readJSON(DB_FILE)).filter(o => o.whatsapp === key);
    const deposits = readJSON(DEPOSITS_FILE).filter(d => d.whatsapp === key && d.status === 'confirmed');
    const totalOrder = orders.length;
    const totalSpent = orders.reduce((s, o) => s + o.total, 0);
    const totalDeposit = deposits.reduce((s, d) => s + d.nominal, 0);
    const totalPending = orders.filter(o => o.status === 'pending').length;
    const totalPaid = orders.filter(o => o.status === 'paid').length;
    const totalRefund = orders.filter(o => o.status === 'refunded').reduce((s, o) => s + o.total, 0);
    const byPlatform = {};
    orders.forEach(o => { byPlatform[o.platform] = (byPlatform[o.platform] || 0) + 1; });
    const last7 = [];
    for (let i = 6; i >= 0; i--) {
      const d = new Date(); d.setDate(d.getDate() - i);
      const k = d.toDateString();
      const count = orders.filter(o => new Date(o.createdAt).toDateString() === k).length;
      last7.push({ date: d.toLocaleDateString('id-ID', { day:'2-digit', month:'short' }), count });
    }
    res.json({ success: true, stats: { totalOrder, totalSpent, totalDeposit, totalPending, totalPaid, totalRefund, byPlatform, last7 } });
  } catch (err) { console.error(err); res.status(500).json({ success: false, message: 'Server error' }); }
});

