  try {
    const { code, type, value, description } = req.body;
    if (!code || !type || !value) return res.status(400).json({ success: false, message: 'Data tidak lengkap' });
    if (!['percent', 'fixed'].includes(type)) return res.status(400).json({ success: false, message: 'Tipe tidak valid' });
    const vouchers = readJSON(VOUCHERS_FILE);
    if (vouchers.find(v => v.code.toUpperCase() === code.toUpperCase())) return res.status(400).json({ success: false, message: 'Kode sudah ada' });
    vouchers.push({ code: code.toUpperCase(), type, value: parseInt(value), description: description || '', active: true, usedBy: [], createdAt: new Date().toISOString() });
    writeJSON(VOUCHERS_FILE, vouchers);
    res.json({ success: true, message: 'Voucher dibuat' });
  } catch (err) { console.error(err); res.status(500).json({ success: false, message: 'Server error' }); }
});

app.post('/api/admin/voucher/toggle/:code', (req, res) => {
  const vouchers = readJSON(VOUCHERS_FILE);
  const idx = vouchers.findIndex(v => v.code === req.params.code);
  if (idx === -1) return res.status(404).json({ success: false, message: 'Voucher tidak ditemukan' });
  vouchers[idx].active = !vouchers[idx].active;
  writeJSON(VOUCHERS_FILE, vouchers);
  res.json({ success: true, message: 'Voucher ' + (vouchers[idx].active ? 'aktif' : 'nonaktif') });
});

