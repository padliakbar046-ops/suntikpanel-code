function readJSON(file) { return JSON.parse(fs.readFileSync(file)); }
function writeJSON(file, data) { fs.writeFileSync(file, JSON.stringify(data, null, 2)); }

const HARGA = {
  tiktok:    { like:7000, view:6000, follower:55000, comment:35000, share:10000 },
  instagram: { like:8000, view:7000, follower:35000, comment:42000, share:12000 },
  facebook:  { like:10000, view:12000, follower:40000, comment:48000, share:15000 }
};

const DISKON_RESELLER = 0.15;
const SATUAN = { like:1000, view:1000, follower:1000, comment:100, share:1000 };
const MIN_ORDER = { like:100, view:100, follower:100, comment:50, share:100 };
const MIN_CHARGE = 5000;
const WA_ADMIN = '6289674642514';

function hitungHarga(platform, layanan, jumlah, level) {
  let hargaSatuan = HARGA[platform][layanan];
  if (level === 'reseller') {
    hargaSatuan = Math.round(hargaSatuan * (1 - DISKON_RESELLER));
  }
  const satuan = SATUAN[layanan];
  let total = Math.ceil((jumlah / satuan) * hargaSatuan);
  if (total < MIN_CHARGE) total = MIN_CHARGE;
  return { hargaSatuan, total };
}

