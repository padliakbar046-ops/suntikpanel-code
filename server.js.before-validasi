app.post('/api/order', async (req, res) => {
  try {
    const { platform, layanan, link, jumlah, whatsapp, voucher } = req.body;
    if (!platform || !layanan || !link || !jumlah || !whatsapp) return res.status(400).json({ success: false, message: 'Data tidak lengkap' });
    if (!HARGA[platform] || !HARGA[platform][layanan]) return res.status(400).json({ success: false, message: 'Layanan tidak valid' });
    const minOrder = MIN_ORDER[layanan] || 100;
    if (jumlah < minOrder) return res.status(400).json({ success: false, message: 'Minimal order ' + minOrder });

    const key = whatsapp.replace(/[^0-9]/g, '');
    const users = readJSON(USERS_FILE);
    const user = users[key];
    if (!user) return res.status(400).json({ success: false, message: 'User tidak ditemukan' });

    const level = user.level || 'user';
    const { hargaSatuan, total: totalBeforeVoucher } = hitungHarga(platform, layanan, jumlah, level);
    let total = totalBeforeVoucher;

    let voucherUsed = null;
    if (voucher) {
      const vouchers = readJSON(VOUCHERS_FILE);
      const v = vouchers.find(x => x.code.toUpperCase() === voucher.toUpperCase() && x.active);
      if (!v) return res.status(400).json({ success: false, message: 'Voucher tidak valid' });
      if (v.usedBy && v.usedBy.includes(key)) return res.status(400).json({ success: false, message: 'Voucher sudah pernah dipakai' });
      if (v.type === 'percent') {
        total = Math.max(MIN_CHARGE, Math.round(total * (1 - v.value / 100)));
      } else if (v.type === 'fixed') {
        total = Math.max(MIN_CHARGE, total - v.value);
      }
      voucherUsed = v.code;
      v.usedBy = v.usedBy || [];
      v.usedBy.push(key);
      writeJSON(VOUCHERS_FILE, vouchers);
    }

    if ((user.saldo || 0) < total) return res.status(400).json({ success: false, message: 'Saldo tidak cukup. Butuh Rp ' + total.toLocaleString('id-ID') });

    user.saldo -= total;
    writeJSON(USERS_FILE, users);

    const orderId = 'INV' + Date.now();
    const order = {
      orderId, platform, layanan, link, jumlah,
      whatsapp: key, nama: user.nama, level,
      hargaSatuan, total, voucher: voucherUsed,
      status: 'pending',
      provider_mode: provider.mode,
      provider_order_id: null,
      provider_status: null,
      createdAt: new Date().toISOString()
    };
    const orders = readJSON(DB_FILE);
    orders[orderId] = order;
    writeJSON(DB_FILE, orders);

    try {
      const result = await provider.order({ platform, layanan, link, jumlah });
      if (result.success) {
        order.provider_order_id = result.provider_order_id;
        order.provider_status = 'Pending';
        order.status = 'processing';
        order.sentAt = new Date().toISOString();
      } else {
        const users2 = readJSON(USERS_FILE);
        if (users2[key]) {
          users2[key].saldo = (users2[key].saldo || 0) + total;
          writeJSON(USERS_FILE, users2);
        }
        order.status = 'refunded';
        order.refundStatus = 'refunded';
        order.refundReason = 'Gagal kirim ke provider: ' + (result.message || 'unknown');
        order.refundedAt = new Date().toISOString();
      }
    } catch (err) {
      console.error('[ORDER] Provider error:', err.message);
      const users2 = readJSON(USERS_FILE);
      if (users2[key]) {
        users2[key].saldo = (users2[key].saldo || 0) + total;
        writeJSON(USERS_FILE, users2);
      }
      order.status = 'refunded';
      order.refundStatus = 'refunded';
      order.refundReason = 'Provider error: ' + err.message;
      order.refundedAt = new Date().toISOString();
    }
    writeJSON(DB_FILE, orders);

    const saldoSisa = readJSON(USERS_FILE)[key].saldo;
    const pesan = 'Halo Admin SuntikPanel\n\nOrder baru:\nID: ' + orderId + '\nNama: ' + user.nama + ' (' + level + ')\nWA: ' + key + '\nPlatform: ' + platform + '\nLayanan: ' + layanan + '\nLink: ' + link + '\nJumlah: ' + jumlah + '\nTotal: Rp ' + total.toLocaleString('id-ID') + '\nStatus: ' + order.status;
    res.json({ success: true, orderId, total, saldoSisa, status: order.status, providerOrderId: order.provider_order_id, waLink: 'https://wa.me/' + WA_ADMIN + '?text=' + encodeURIComponent(pesan) });
  } catch (err) { console.error(err); res.status(500).json({ success: false, message: 'Server error' }); }
});

